# =============================================================================
# UniSOC Sentinel — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# Secrets (passwords, keys) are stored in ./secrets/ files — NOT here.
# Run ./scripts/generate-secrets.sh to create them.
# =============================================================================


# -----------------------------------------------------------------------------
# TLS / Domain Configuration
# -----------------------------------------------------------------------------

# Public FQDN or IP address where the SIEM will be reachable.
# Used by nginx for virtual host routing and Let's Encrypt certificate issuance.
DOMAIN=localhost

# TLS certificate provisioning mode.
#   self-signed   — Generate a self-signed certificate (development / lab use)
#   letsencrypt   — Obtain a certificate from Let's Encrypt via ACME HTTP-01
#                   Requires DOMAIN to be publicly reachable on port 80.
TLS_MODE=self-signed

# Email address used for Let's Encrypt registration and expiry notifications.
# Required when TLS_MODE=letsencrypt.
LETSENCRYPT_EMAIL=admin@localhost


# -----------------------------------------------------------------------------
# OpenSearch
# -----------------------------------------------------------------------------

# Initial admin password for the OpenSearch built-in admin account.
# NOTE: OpenSearch does not support Docker secrets (_FILE env vars) natively,
#       so this password is passed directly as an environment variable.
#       Change this before deploying to production.
# Complexity requirements: at least 8 chars, upper, lower, digit, symbol.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMe_1234!


# -----------------------------------------------------------------------------
# Syslog Ingestion Service
# -----------------------------------------------------------------------------

# Host interface to bind the UDP syslog listener.
# Use 0.0.0.0 to listen on all interfaces (default).
# Restrict to a specific interface IP for tighter network isolation.
SYSLOG_BIND_HOST=0.0.0.0

# Internal receive buffer size (number of log entries held in memory).
# Increase if you see dropped messages under high load.
SYSLOG_BUFFER_SIZE=10000

# Number of async worker coroutines processing the syslog receive buffer.
SYSLOG_WORKERS=4


# -----------------------------------------------------------------------------
# Parser Pipeline Service
# -----------------------------------------------------------------------------

# Number of concurrent worker coroutines consuming the Redis raw_logs stream.
PARSER_WORKERS=2

# Number of log entries processed per Redis XREADGROUP batch call.
PARSER_BATCH_SIZE=100

# MaxMind GeoLite2 license key for automatic GeoIP database downloads.
# Sign up for free at https://www.maxmind.com/en/geolite2/signup
# Leave blank to skip automatic updates (manually place the .mmdb file
# in the geoip-data volume at /data/geoip/GeoLite2-City.mmdb).
MAXMIND_LICENSE_KEY=


# -----------------------------------------------------------------------------
# SIEM Core API Service
# -----------------------------------------------------------------------------

# Number of Uvicorn worker processes.
# Recommended: (CPU cores × 2) + 1, capped at 8 for this container size.
SIEM_CORE_WORKERS=4

# Comma-separated list of allowed CORS origins for the REST API.
# Include all origins from which the dashboard or API clients will connect.
CORS_ORIGINS=http://localhost,https://localhost


# -----------------------------------------------------------------------------
# Alerting Engine Service
# -----------------------------------------------------------------------------

# Seconds to suppress duplicate alerts for the same dedup_key.
# Prevents alert storms when a condition persists.
ALERT_DEDUP_TTL=3600


# -----------------------------------------------------------------------------
# Email Notifier Service
# -----------------------------------------------------------------------------

# SMTP server hostname or IP address.
SMTP_HOST=smtp.example.com

# SMTP server port.
#   587  — STARTTLS (recommended)
#   465  — Implicit TLS (SMTPS)
#   25   — Unencrypted (not recommended)
SMTP_PORT=587

# SMTP authentication username. Leave blank for unauthenticated relay.
SMTP_USER=siem@example.com

# Sender address shown in the From header of alert emails.
SMTP_FROM=siem-alerts@example.com

# Enable STARTTLS negotiation.
#   true  — Upgrade plain connection to TLS using STARTTLS (port 587)
#   false — Send without encryption (use only on trusted internal relays)
SMTP_STARTTLS=true

# Comma-separated list of email addresses that receive alert notifications.
ALERT_RECIPIENTS=security-team@example.com,noc@example.com


# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------

# Grafana admin username.
GRAFANA_ADMIN_USER=admin

# Grafana admin password. Change before deploying to production.
GRAFANA_ADMIN_PASSWORD=changeme


# -----------------------------------------------------------------------------
# Host Port Bindings
# -----------------------------------------------------------------------------

# TCP port the reverse proxy listens on for HTTP traffic.
# Requests on this port are redirected to HTTPS.
HTTP_PORT=80

# TCP port the reverse proxy listens on for HTTPS (TLS-terminated) traffic.
HTTPS_PORT=443


# -----------------------------------------------------------------------------
# Global Logging
# -----------------------------------------------------------------------------

# Log verbosity for all Python services.
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
